/* style.qss - Notion 極簡視覺修正版 */

QWidget {
    background-color: #191919;
    color: #EBEBEA;
    font-family: "Microsoft JhengHei", "微軟正黑體", sans-serif;
    font-size: 14px;
}

QLabel#TitleLabel { font-size: 28px; font-weight: bold; }
QLabel#SubTitleLabel { color: #9B9A97; }

/* --- 樹狀清單 --- */
QTreeWidget {
    outline: none;
    background: transparent;
    border: none;
}
QTreeWidget::item {
    height: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}
QTreeWidget::item:hover { background-color: rgba(255, 255, 255, 0.04); }
QTreeWidget::item:selected { background-color: transparent; color: #EBEBEA; }
QTreeView::branch:selected, QTreeView::branch:hover { background-color: transparent; }

/* --- 全域 QCheckBox (Notion 風格) --- */
QCheckBox { spacing: 8px; color: #9B9A97; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border-radius: 4px;
    border: 1.5px solid #444444;
    background: transparent;
}
QCheckBox::indicator:checked {
    background-color: #EBEBEA;
    border: 1.5px solid #EBEBEA;
    image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%23191919" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>');
}

/* --- 分類標籤按鈕 --- */
QPushButton#TagButton {
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
    border: none;
    padding: 2px 5px;
    min-height: 22px;
    max-height: 24px;
}
QPushButton::menu-indicator { image: none; } 

/* -------------------------------------------
   核心修正：底部按鈕樣式重構
------------------------------------------- */

/* 1. 左側按鈕 (完全去掉邊框，僅在 Hover 時顯示底色) */
QPushButton#SettingsButton, QPushButton#RefreshButton {
    background-color: transparent;
    color: #9B9A97;
    border: none; /* 移除邊框 */
    min-height: 40px;
    padding: 0 15px;
    text-align: center;
}
QPushButton#SettingsButton:hover, QPushButton#RefreshButton:hover {
    background-color: rgba(255, 255, 255, 0.05); /* 輕微底色反饋 */
    color: #EBEBEA;
}

/* 2. 右側主按鈕 (去掉背景色，保留細邊框) */
QPushButton#ArchiveButton {
    background-color: transparent; /* 去掉背景 */
    color: #EBEBEA;
    font-weight: bold;
    font-size: 14px;
    border-radius: 6px;
    border: 1px solid #3F3F3F; /* 保留邊框 */
    min-height: 45px;
    padding: 0 25px;
}
QPushButton#ArchiveButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid #666666; /* Hover 時邊框亮起 */
}
QPushButton#ArchiveButton:pressed {
    background-color: rgba(255, 255, 255, 0.1);
}

/* 3. 啟動器導航按鈕 (統一) */
QPushButton#NavButton {
    background-color: transparent;
    border-radius: 8px;
    border: none;
    min-height: 50px;
}