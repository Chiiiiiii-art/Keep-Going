/* style.qss - Keep-Going Notion 視覺終極隔離版 */

/* --- 1. 全域基礎設定 --- */
QWidget {
    background-color: #191919;
    color: #EBEBEA;
    font-family: "Microsoft JhengHei", "微軟正黑體", sans-serif;
    font-size: 14px;
}

QLabel#TitleLabel { font-size: 28px; font-weight: bold; }
QLabel#SubTitleLabel { color: #9B9A97; }

/* --- 2. 樹狀清單 --- */
QTreeWidget { background: transparent; border: none; outline: none; }
QTreeWidget::item { height: 48px; border-bottom: 1px solid rgba(255, 255, 255, 0.03); }
QTreeWidget::item:hover { background-color: rgba(255, 255, 255, 0.04); }
QTreeWidget::item:selected { background-color: transparent; }

/* --- 3. 啟動器導航按鈕 (隔離關鍵) --- */
QPushButton#NavButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    min-height: 50px;
    padding: 0 15px;
    text-align: left;
}
QPushButton#NavButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
}
QPushButton#NavButton QLabel { background: transparent; }

/* --- 4. 下拉選單 (QMenu) --- */
QMenu {
    background-color: #252525;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item {
    padding: 8px 32px 8px 10px;
    border-radius: 4px;
    color: white; /* 分類項目文字一律白色 */
}
QMenu::item:selected {
    background-color: rgba(255, 255, 255, 0.08); /* 懸停高亮 */
}
QMenu::separator { height: 1px; background: #333333; margin: 6px 8px; }

/* --- 5. 功能按鈕 --- */
QPushButton#SettingsButton, QPushButton#RefreshButton {
    background-color: transparent;
    color: #9B9A97;
    border: none;
    min-height: 40px;
}
QPushButton#SettingsButton:hover, QPushButton#RefreshButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #EBEBEA;
}

QPushButton#ArchiveButton {
    background-color: transparent;
    color: #EBEBEA;
    font-weight: bold;
    border-radius: 6px;
    border: 1px solid #3F3F3F;
    min-height: 45px;
    padding: 0 25px;
}
QPushButton#ArchiveButton:hover {
    border: 1px solid #666666;
    background-color: rgba(255, 255, 255, 0.03);
}

/* --- 6. 輸入框 --- */
QLineEdit#NoteEdit { background: transparent; color: #9B9A97; border: none; font-size: 13px; }
QLineEdit#NoteEdit:focus { color: #EBEBEA; }